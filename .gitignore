# Secrets live in ~/.config/topic-feed/env; never commit env files.
.env
*.env

# Review reports contain post text.
reports/

# Local data, exports, and model files (these live under /data).
data/
exports/
models/
*.parquet
*.onnx

# Go
/bin/
# Binaries left by a bare `go build ./cmd/<name>` in the checkout root.
/feedgen
/images

# The build recipe of the vendored web script (internal/feedgen/webvendor) installs its tools here.
internal/feedgen/webvendor/node_modules/

# Python
.venv/
__pycache__/
*.pyc

# Raw LLM outputs from tools/draft_taxonomy.py
taxonomy/*.work/
