<clickhouse>
    <!-- The machine also trains on the GPU and serves the classifier. The Framework Desktop's 128GB
         is shared with the GPU (32GB reserved for it in the BIOS), leaving about 91GB for the
         system; cap ClickHouse at 32GB of that. -->
    <max_server_memory_usage>34359738368</max_server_memory_usage>

    <!-- ClickHouse's own log tables have no expiry by default. query_log alone grew ~23GB a day
         (186GB after 8 days on the previous machine), which would fill the 931GB disk in about a
         month. These settings merge into the defaults; only the expiry is added. -->
    <query_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></query_log>
    <processors_profile_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></processors_profile_log>
    <trace_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></trace_log>
    <part_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></part_log>
    <metric_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></metric_log>
    <asynchronous_metric_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></asynchronous_metric_log>
    <query_views_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_views_log>

    <logger>
        <level>information</level>
        <size>500M</size>
        <count>5</count>
    </logger>

    <!-- Disk used by `BACKUP TABLE ... TO Disk('backups', '...')` for the nightly backup. -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/backups/</allowed_path>
    </backups>

    <!-- Prometheus metrics at http://127.0.0.1:8123/metrics (the port compose already publishes,
         localhost only). No credentials needed for this path; queries on / still need them.
         <defaults/> keeps the built-in handlers (queries, /ping, /play): without it this rule
         would replace them all. A running server picks this up within seconds, no restart.
         Errors are off: that adds a series per ClickHouse error code (~1000), and the
         failed-query counters already cover what matters. -->
    <http_handlers>
        <rule>
            <url>/metrics</url>
            <methods>GET</methods>
            <handler>
                <type>prometheus</type>
                <metrics>true</metrics>
                <events>true</events>
                <asynchronous_metrics>true</asynchronous_metrics>
                <errors>false</errors>
            </handler>
        </rule>
        <defaults/>
    </http_handlers>
</clickhouse>
