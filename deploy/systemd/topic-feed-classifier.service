[Unit]
Description=topic-feed classifier service (student model on the GPU, trainer/serve.py)
After=network-online.target

[Service]
# Runs on the host, not in Docker: Docker here has no NVIDIA runtime. The pipeline
# container (host network) reaches it on loopback.
# %h is the user's home directory. `make install-classifier` installs this unit.
WorkingDirectory=%h/bluesky/topic-feed/trainer
Environment=MODEL_DIR=/data/models/v4
Environment=SERVE_ADDR=127.0.0.1:8700
Environment=HF_HUB_OFFLINE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.nix-profile/bin/uv run --frozen python serve.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
